{
  "name": "whale-purse",
  "description": "鲸鱼娘桌宠（whale-purse 二改版）· DeepSeek 余额 + 会话用量/花费监视 + petdex deepseek 酱精灵动画 + 后台任务进度卡，直接挂进 DSH Web profile 的组合层（cordis.patch.yml insert，热重载）",
  "version": "1.1.0",
  "author": "Zijian Li (Suiwan/whale-purse 原版) · Lin Yufeng (二改)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "screenshot": "node scripts/screenshot.mjs"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "whale",
    "balance",
    "usage",
    "desktop-pet",
    "cordis",
    "petdex",
    "sprite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/linyufeng123456/dsh_plugins.git",
    "directory": "whale-purse"
  },
  "license": "MIT"
}
